generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences Experience[]
  sessions    Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Experience {
  id          String   @id @default(cuid())
  slug        String   @unique @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "apology", "proposal", "anniversary", etc.
  status      String   // "draft", "published", "unpublished"
  template    String   // "classic", "cinematic", etc.
  
  // Content stored as JSON for flexibility (sections, config)
  content     String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
